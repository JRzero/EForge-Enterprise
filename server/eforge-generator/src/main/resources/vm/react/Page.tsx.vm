    if (!editor?.model) return rows;
    const blocked = new Set([text(editor.model[treeCode])]), pending = [text(editor.model[treeCode])];
    while (pending.length) for (const row of tree.children.get(pending.pop()!) ?? []) {const code = text(row[treeCode]); if (!blocked.has(code)) {blocked.add(code); pending.push(code);}}
