  if (field.html === 'editor') return <RichTextEditor value={text(value)} onChange={onChange} disabled={disabled} uploadImage={async (file, signal) => {changeUploads(1); try {return await api.uploadGeneratedFile(file, signal);} finally {changeUploads(-1);}}} />;
  if (['fileUpload', 'imageUpload'].includes(field.html ?? '')) return <div>
    <input type="file" multiple disabled={disabled || uploading} accept={field.html === 'imageUpload' ? '.jpg,.jpeg,.png,.gif,.webp' : '.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.pdf'} onChange={async event => {
      const files = [...(event.target.files ?? [])]; event.target.value = ''; setError('');
      if (files.length + text(value).split(',').filter(Boolean).length > 5 || files.some(file => file.size > 5 * 1024 * 1024)) {setError('最多上传五个文件，每个不超过 5 MB。'); return;}
      pending.current?.abort(); const controller = new AbortController(); pending.current = controller; setUploading(true); changeUploads(1);
      try {const paths = text(value).split(',').filter(Boolean); for (const file of files) {paths.push(await api.uploadGeneratedFile(file, controller.signal)); if (!controller.signal.aborted) onChange(paths.join(','));}}
