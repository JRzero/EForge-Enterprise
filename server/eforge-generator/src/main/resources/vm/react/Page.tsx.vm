          {!editor.viewing ? <Button label="新增子表行" isDisabled={busy} onClick={() => setEditor(current => current && ({...current, form: {...current.form, [childKey]: [...current.form[childKey], {}]}}))} /> : null}
          <table><thead><tr>{childFields.filter(field => field.key !== childForeignKey && (!field.pk || !field.auto) && (field.insert || field.edit || field.list)).map(field => <th key={field.key}>{field.label}</th>)}{!editor.viewing ? <th>操作</th> : null}</tr></thead>
            <tbody>{(editor.form[childKey] ?? []).map((row, index) => <tr key={index}>
              {childFields.filter(field => field.key !== childForeignKey && (!field.pk || !field.auto) && (field.insert || field.edit || field.list)).map(field => <td key={field.key}><label>{field.label}
                {editor.viewing ? <FieldDisplay field={field} value={fieldValue(row, field.key)} /> : <FieldControl field={field} value={fieldValue(row, field.key)} disabled={operationBusy || !(editor.id === undefined ? field.insert || field.pk && !field.auto : field.edit || field.pk && !field.auto)} onChange={value => setEditor(current => current && ({...current, form: {...current.form, [childKey]: current.form[childKey].map((item, ordinal) => ordinal === index ? {...item, [field.key]: value} : item)}}))} />}
              </label></td>)}
              {!editor.viewing ? <td><Button label="删除子表行" variant="ghost" isDisabled={busy} onClick={() => setEditor(current => current && ({...current, form: {...current.form, [childKey]: current.form[childKey].filter((_, ordinal) => ordinal !== index)}}))} /></td> : null}
            </tr>)}</tbody>
          </table>
        </section>
#end
        {actionError ? <p role="alert">{actionError}</p> : null}
        {!editor.viewing ? <Button label="保存" type="submit" isDisabled={busy} /> : null}<Button label="取消" variant="ghost" isDisabled={busy} onClick={() => setEditor(null)} />
      </form>
    </ResourceDialog></UploadContext.Provider> : null}
    {deleting ? <ResourceDialog titleId="generated-delete-title" alert busy={busy} onCancel={() => setDeleting(null)}><h2 id="generated-delete-title">确认删除所选记录？</h2>
      {actionError ? <p role="alert">{actionError}</p> : null}<Button label="确认删除" isDisabled={busy} onClick={() => {void remove();}} /><Button label="取消" variant="ghost" isDisabled={busy} onClick={() => setDeleting(null)} />
    </ResourceDialog> : null}
  </section>;
}
