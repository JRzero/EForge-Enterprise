    }} />
    {uploading ? <p role="status">正在上传…</p> : null}{error ? <p role="alert">{error}</p> : null}
    {text(value).split(',').filter(Boolean).map(path => <div key={path}><span>{path.split('/').at(-1)}</span><Button label="移除文件" variant="ghost" isDisabled={disabled || uploading} onClick={() => onChange(text(value).split(',').filter(item => item !== path).join(','))} /></div>)}
  </div>;
  if (field.html === 'textarea') return <textarea value={text(value)} disabled={disabled} required={field.required} onChange={event => onChange(event.target.value)} />;
  return <input value={field.type === 'Date' ? localDate(value) : text(value)} disabled={disabled} required={field.required}
    type={field.type === 'Date' ? 'datetime-local' : 'text'} step={field.type === 'Date' ? '.001' : undefined}
    inputMode={field.type === 'Long' || field.type === 'BigDecimal' ? 'decimal' : undefined}
