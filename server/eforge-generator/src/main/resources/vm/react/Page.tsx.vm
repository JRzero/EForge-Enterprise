        if (item.visible) {visible.push(item.row); levels.set(key, item.depth);}
        const descendants = children.get(text(item.row[treeCode])) ?? [];
        for (let index = descendants.length - 1; index >= 0; index--) pending.push({row: descendants[index]!, depth: item.depth + 1, visible: item.visible && expanded.has(text(item.row[treeCode]))});
      }
