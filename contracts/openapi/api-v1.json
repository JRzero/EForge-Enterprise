{
  "components": {
    "schemas": {
      "BootstrapResponse": {
        "properties": {
          "navigation": {
            "items": {
              "$ref": "#/components/schemas/NavigationNode"
            },
            "type": "array"
          },
          "permissions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "roles": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "user": {
            "$ref": "#/components/schemas/UserSummary"
          }
        },
        "required": [
          "navigation",
          "permissions",
          "roles",
          "user"
        ],
        "type": "object"
      },
      "CreateUserRequest": {
        "properties": {
          "password": {
            "maxLength": 20,
            "minLength": 5,
            "pattern": "[^<>\"'|\\\\]+",
            "type": "string",
            "writeOnly": true
          },
          "user": {
            "$ref": "#/components/schemas/UserWriteRequest"
          }
        },
        "required": [
          "password",
          "user"
        ],
        "type": "object"
      },
      "DeletePostsRequest": {
        "properties": {
          "ids": {
            "items": {
              "pattern": "[1-9][0-9]{0,18}",
              "type": "string"
            },
            "maxItems": 100,
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "ids"
        ],
        "type": "object"
      },
      "DeleteUsersRequest": {
        "properties": {
          "ids": {
            "items": {
              "pattern": "[1-9][0-9]{0,18}",
              "type": "string"
            },
            "maxItems": 100,
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "ids"
        ],
        "type": "object"
      },
      "DepartmentRequest": {
        "properties": {
          "email": {
            "format": "email",
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "leader": {
            "maxLength": 20,
            "minLength": 0,
            "type": "string"
          },
          "name": {
            "maxLength": 30,
            "minLength": 0,
            "type": "string"
          },
          "parentId": {
            "pattern": "0|[1-9][0-9]{0,18}",
            "type": "string"
          },
          "phone": {
            "maxLength": 11,
            "minLength": 0,
            "type": "string"
          },
          "sort": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "status": {
            "pattern": "[01]",
            "type": "string"
          }
        },
        "required": [
          "name",
          "parentId",
          "sort",
          "status"
        ],
        "type": "object"
      },
      "DepartmentResponse": {
        "properties": {
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "leader": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "parentId": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "sort": {
            "format": "int32",
            "type": "integer"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "parentId",
          "sort",
          "status"
        ],
        "type": "object"
      },
      "DepartmentSortRequest": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Item"
            },
            "maxItems": 1000,
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "Item": {
        "properties": {
          "id": {
            "pattern": "[1-9][0-9]{0,18}",
            "type": "string"
          },
          "sort": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "id",
          "sort"
        ],
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "code": {
            "maxLength": 128,
            "minLength": 0,
            "type": "string"
          },
          "password": {
            "maxLength": 20,
            "minLength": 0,
            "type": "string",
            "writeOnly": true
          },
          "username": {
            "maxLength": 20,
            "minLength": 0,
            "type": "string"
          },
          "uuid": {
            "maxLength": 128,
            "minLength": 0,
            "type": "string"
          }
        },
        "required": [
          "password",
          "username"
        ],
        "type": "object"
      },
      "LoginResponse": {
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "tokenType": {
            "type": "string"
          }
        },
        "required": [
          "accessToken",
          "tokenType"
        ],
        "type": "object"
      },
      "NavigationNode": {
        "properties": {
          "children": {
            "items": {
              "$ref": "#/components/schemas/NavigationNode"
            },
            "type": "array"
          },
          "externalUrl": {
            "description": "Present only for EXTERNAL nodes",
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "order": {
            "format": "int32",
            "type": "integer"
          },
          "routeId": {
            "description": "Present only for ROUTE nodes",
            "type": "string"
          },
          "type": {
            "enum": [
              "GROUP",
              "ROUTE",
              "EXTERNAL"
            ],
            "type": "string"
          }
        },
        "required": [
          "children",
          "key",
          "label",
          "order",
          "type"
        ],
        "type": "object"
      },
      "PageResponsePostResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/PostResponse"
            },
            "type": "array"
          },
          "page": {
            "format": "int32",
            "type": "integer"
          },
          "pageSize": {
            "format": "int32",
            "type": "integer"
          },
          "total": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "page",
          "pageSize",
          "total"
        ],
        "type": "object"
      },
      "PageResponseUserResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/UserResponse"
            },
            "type": "array"
          },
          "page": {
            "format": "int32",
            "type": "integer"
          },
          "pageSize": {
            "format": "int32",
            "type": "integer"
          },
          "total": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "page",
          "pageSize",
          "total"
        ],
        "type": "object"
      },
      "PostRequest": {
        "properties": {
          "code": {
            "maxLength": 64,
            "minLength": 0,
            "type": "string"
          },
          "name": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "remark": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string"
          },
          "sort": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "status": {
            "pattern": "[01]",
            "type": "string"
          }
        },
        "required": [
          "code",
          "name",
          "sort",
          "status"
        ],
        "type": "object"
      },
      "PostResponse": {
        "properties": {
          "code": {
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "remark": {
            "type": "string"
          },
          "sort": {
            "format": "int32",
            "type": "integer"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "id",
          "name",
          "sort",
          "status"
        ],
        "type": "object"
      },
      "ProblemDetail": {
        "properties": {
          "detail": {
            "type": [
              "string",
              "null"
            ]
          },
          "instance": {
            "format": "uri",
            "type": [
              "string",
              "null"
            ]
          },
          "properties": {
            "additionalProperties": {},
            "type": [
              "object",
              "null"
            ]
          },
          "status": {
            "format": "int32",
            "type": "integer"
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "format": "uri",
            "type": "string"
          }
        },
        "type": "object"
      },
      "ResetUserPasswordRequest": {
        "properties": {
          "password": {
            "maxLength": 20,
            "minLength": 5,
            "pattern": "[^<>\"'|\\\\]+",
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "password"
        ],
        "type": "object"
      },
      "UserEditorResponse": {
        "properties": {
          "postIds": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "roleIds": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "user": {
            "$ref": "#/components/schemas/UserResponse"
          }
        },
        "required": [
          "postIds",
          "roleIds",
          "user"
        ],
        "type": "object"
      },
      "UserImportResponse": {
        "properties": {
          "created": {
            "format": "int32",
            "type": "integer"
          },
          "failed": {
            "format": "int32",
            "type": "integer"
          },
          "rows": {
            "items": {
              "$ref": "#/components/schemas/UserImportRow"
            },
            "type": "array"
          },
          "total": {
            "format": "int32",
            "type": "integer"
          },
          "updated": {
            "format": "int32",
            "type": "integer"
          }
        },
        "required": [
          "created",
          "failed",
          "rows",
          "total",
          "updated"
        ],
        "type": "object"
      },
      "UserImportRow": {
        "properties": {
          "code": {
            "type": "string"
          },
          "outcome": {
            "enum": [
              "CREATED",
              "UPDATED",
              "FAILED"
            ],
            "type": "string"
          },
          "row": {
            "description": "One-based imported record ordinal",
            "format": "int32",
            "type": "integer"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "outcome",
          "row",
          "username"
        ],
        "type": "object"
      },
      "UserOption": {
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "status"
        ],
        "type": "object"
      },
      "UserOptionsResponse": {
        "properties": {
          "departments": {
            "items": {
              "$ref": "#/components/schemas/DepartmentResponse"
            },
            "type": "array"
          },
          "initialPassword": {
            "readOnly": true,
            "type": "string"
          },
          "posts": {
            "items": {
              "$ref": "#/components/schemas/UserOption"
            },
            "type": "array"
          },
          "roles": {
            "items": {
              "$ref": "#/components/schemas/UserOption"
            },
            "type": "array"
          }
        },
        "required": [
          "departments",
          "initialPassword",
          "posts",
          "roles"
        ],
        "type": "object"
      },
      "UserResponse": {
        "properties": {
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "departmentId": {
            "type": "string"
          },
          "departmentName": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "remark": {
            "type": "string"
          },
          "sex": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "displayName",
          "id",
          "status",
          "username"
        ],
        "type": "object"
      },
      "UserRolesRequest": {
        "properties": {
          "roleIds": {
            "items": {
              "pattern": "[1-9][0-9]{0,18}",
              "type": "string"
            },
            "maxItems": 100,
            "minItems": 0,
            "type": "array"
          }
        },
        "required": [
          "roleIds"
        ],
        "type": "object"
      },
      "UserStatusRequest": {
        "properties": {
          "status": {
            "pattern": "[01]",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "UserSummary": {
        "properties": {
          "displayName": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "displayName",
          "id",
          "username"
        ],
        "type": "object"
      },
      "UserWriteRequest": {
        "properties": {
          "departmentId": {
            "pattern": "[1-9][0-9]{0,18}",
            "type": "string"
          },
          "displayName": {
            "maxLength": 30,
            "minLength": 0,
            "type": "string"
          },
          "email": {
            "format": "email",
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "phone": {
            "pattern": "(?:1[3-9][0-9]{9})?",
            "type": "string"
          },
          "postIds": {
            "items": {
              "pattern": "[1-9][0-9]{0,18}",
              "type": "string"
            },
            "maxItems": 100,
            "minItems": 0,
            "type": "array"
          },
          "remark": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string"
          },
          "roleIds": {
            "items": {
              "pattern": "[1-9][0-9]{0,18}",
              "type": "string"
            },
            "maxItems": 100,
            "minItems": 0,
            "type": "array"
          },
          "sex": {
            "pattern": "[012]",
            "type": "string"
          },
          "status": {
            "pattern": "[01]",
            "type": "string"
          },
          "username": {
            "maxLength": 20,
            "minLength": 2,
            "type": "string"
          }
        },
        "required": [
          "displayName",
          "postIds",
          "roleIds",
          "sex",
          "status",
          "username"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "apikey": {
        "in": "header",
        "name": "Authorization",
        "scheme": "Bearer",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "contact": {
      "name": "EForge Enterprise"
    },
    "description": "描述：用于管理集团旗下公司的人员信息,具体包括XXX,XXX模块...",
    "title": "标题：若依管理系统_接口文档",
    "version": "版本号:0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/app/bootstrap": {
      "get": {
        "operationId": "bootstrap",
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/BootstrapResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Get the current user and authorized application navigation",
        "tags": [
          "bootstrap-controller"
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            },
            "description": "Authenticated"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Invalid request or captcha"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Login rejected"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Login blocked"
          }
        },
        "security": [],
        "summary": "Create a Redis-backed login session",
        "tags": [
          "auth-controller"
        ]
      }
    },
    "/api/v1/system/departments": {
      "get": {
        "operationId": "listDepartments",
        "parameters": [
          {
            "in": "query",
            "name": "name",
            "required": false,
            "schema": {
              "default": "",
              "maxLength": 30,
              "minLength": 0,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "default": "",
              "pattern": "[01]?",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "excludeId",
            "required": false,
            "schema": {
              "pattern": "[1-9][0-9]{0,18}",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DepartmentResponse"
                  },
                  "type": "array"
                }
              }
            },
            "description": "OK"
          }
        },
        "tags": [
          "department-controller"
        ]
      },
      "post": {
        "operationId": "createDepartment",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DepartmentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/DepartmentResponse"
                }
              }
            },
            "description": "Created department"
          }
        },
        "tags": [
          "department-controller"
        ]
      }
    },
    "/api/v1/system/departments/sort": {
      "put": {
        "operationId": "sortDepartments",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DepartmentSortRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Department order saved"
          }
        },
        "tags": [
          "department-controller"
        ]
      }
    },
    "/api/v1/system/departments/{id}": {
      "delete": {
        "operationId": "deleteDepartment",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "pattern": "[1-9][0-9]{0,18}",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Department deleted"
          }
        },
        "tags": [
          "department-controller"
        ]
      },
      "get": {
        "operationId": "getDepartment",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "pattern": "[1-9][0-9]{0,18}",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/DepartmentResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "tags": [
          "department-controller"
        ]
      },
      "put": {
        "operationId": "updateDepartment",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "pattern": "[1-9][0-9]{0,18}",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DepartmentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/DepartmentResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "tags": [
          "department-controller"
        ]
      }
    },
    "/api/v1/system/posts": {
      "delete": {
        "operationId": "deletePosts",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeletePostsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Posts deleted"
          }
        },
        "tags": [
          "post-controller"
        ]
      },
      "get": {
        "operationId": "listPosts",
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "format": "int32",
              "maximum": 1000000,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "pageSize",
            "required": false,
            "schema": {
              "default": 10,
              "format": "int32",
